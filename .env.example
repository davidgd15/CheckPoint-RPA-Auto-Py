# Copie este arquivo para ".env" e preencha os valores.
SITE_URL=http://127.0.0.1:5000
MONITOR_TOKEN=troque-por-um-token-longo
DB_PATH=chamados.db

# Monitor
POLL_INTERVAL=30        # segundos entre verificações
LEMBRETE_DIAS=2         # chamados abertos há N dias geram lembrete
RESUMO_HORA=8           # hora (0-23) do resumo diário
MAX_TENTATIVAS=5        # tentativas de envio por chamado antes de desistir

# E-mail (Gmail: use uma "senha de app")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu.email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
EMAIL_DESTINO=rm98603@fiap.com.br
